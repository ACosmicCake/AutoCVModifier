# Copy this file to .env and fill in at least one API key.

# Google Gemini API key, used for gemini/* models (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=""

# OpenRouter API key, used for all other models (https://openrouter.ai/keys)
OPENROUTER_API_KEY=""

# Flask secret key. Leave blank to auto-generate a temporary one at startup.
# Generate a persistent one with: python -c "import secrets; print(secrets.token_hex(16))"
SECRET_KEY=""

# Optional: how many CVs to generate in parallel during batch generation (default 3)
# BATCH_MAX_WORKERS=3
